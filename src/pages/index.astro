---
import '../styles/global.css';
---

<html lang="en" data-theme="paper">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
	</head>
	<body>
		<!-- Step 1 verification only — real markup arrives in step 2 (Layout + Background). -->
		<h1 class="text-t-name" style="color: var(--accent); font-family: var(--font-mono);">Token check</h1>
		<p style="color: var(--muted);">If this renders in the mono font, in blue-grey accent colour, on the paper background, the token pipeline works.</p>
	</body>
</html>
