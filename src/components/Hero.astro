---
// Name, role pill (with live local-time clock), paw trail, portrait disc.
// Portrait photo is a TODO (brief section 8) — reference file shows a
// plain "Photo" mono placeholder rather than a real <img>, so that's what
// is ported here. Swap for <img src="/images/imethma.jpg" alt="Imethma
// Kariyawasam" loading="eager"> once the file exists (brief section 7:
// portrait should load eager, not lazy).
import { site } from "../data/site";
import Paws from "./Paws.astro";
---

<section class="hero">
  <div></div>
  <div class="rise" style="animation-delay:.10s">
    <h1 class="name">{site.name}</h1>
    <span class="role">
      {site.role}
      <span class="sep">&middot;</span>
      <span id="clock">--:--</span>
    </span>
    <Paws direction="east" />
  </div>
  <div class="rise" style="animation-delay:.16s">
    <div class="disc"><span class="mono">Photo</span></div>
  </div>
</section>
