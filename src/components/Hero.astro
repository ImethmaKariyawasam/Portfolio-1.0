---
// Name, role pill (with live local-time clock), paw trail, portrait disc.
// Portrait loads eager (not lazy) per brief section 7 — it's above the
// fold and the largest visual element on first paint.
import { site } from "../data/site";
import Paws from "./Paws.astro";
---

<section class="hero">
  <div></div>
  <div class="rise" style="animation-delay:.10s">
    <h1 class="name">{site.name}</h1>
    <span class="role">{site.role}</span>
    <span class="hero-loc mono">{site.location.label}</span>
    <Paws direction="east" />
  </div>
  <div class="rise" style="animation-delay:.16s">
    <div class="disc">
      <img src={site.photo} alt={site.name} width="148" height="148" loading="eager" />
    </div>
  </div>
</section>
