---
// The one card used everywhere: projects, experience, education, the
// publication, and the "duo" interest cards. Variants match the
// reference file's `.card`, `.card.quiet`, and duo-context usage.
export interface Props {
  variant?: "default" | "quiet";
  monogram?: string;
  logo?: string;
  num?: string; // "01" prefix shown before the title
  title: string;
  date?: string; // mono text, top-right of the card head
  headLink?: { href: string; label: string }; // arrow-only link; label is used as the accessible name, not shown
  sub?: string;
  body?: string;
  credit?: string; // small mono line below body/bullets
  bullets?: string[];
  tags?: string[];
  link?: { href: string; label: string }; // bottom link, e.g. "Read the paper"
}
const { variant = "default", monogram, logo, num, title, date, headLink, sub, body, credit, bullets, tags, link } =
  Astro.props;
const cardClass = variant === "quiet" ? "card quiet" : "card";
---

<article class={cardClass}>
  {(logo || monogram) && (
    <div class={logo ? "tile has-logo" : "tile"}>
      {logo ? <img src={logo} alt={title} loading="lazy" /> : monogram}
    </div>
  )}
  <div>
    <div class="card-head">
      <h3 class="card-title">
        {num && <span class="num mono">{num}</span>}{title}
      </h3>
      {date && <span class="mono">{date}</span>}
      {headLink && (
        <a class="link" href={headLink.href} aria-label={headLink.label}>
          <span class="arw">&rarr;</span>
        </a>
      )}
    </div>
    {sub && <p class="card-sub">{sub}</p>}
    {body && <p class="card-body">{body}</p>}
    {credit && <p class="card-body">{credit}</p>}
    {bullets && bullets.length > 0 && (
      <ul>
        {bullets.map((b) => (
          <li>{b}</li>
        ))}
      </ul>
    )}
    {tags && tags.length > 0 && (
      <div class="tags">
        {tags.map((t) => (
          <span>{t}</span>
        ))}
      </div>
    )}
    {link && (
      <a class="link" href={link.href}>
        {link.label} <span class="arw">&rarr;</span>
      </a>
    )}
  </div>
</article>
